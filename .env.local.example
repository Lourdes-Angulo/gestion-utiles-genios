# Copia este archivo a .env.local y rellena tus valores.
# .env.local está en .gitignore y NUNCA se sube al repositorio.

# Clave de la API de Gemini (solo si implementas la predicción con IA)
GEMINI_API_KEY=""

# URL donde se aloja la app (para enlaces internos / callbacks)
APP_URL="http://localhost:3000"
